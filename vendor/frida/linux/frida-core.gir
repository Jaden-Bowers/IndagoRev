    <class name="DeviceManager" c:type="FridaDeviceManager" c:symbol-prefix="device_manager" glib:type-name="FridaDeviceManager" glib:get-type="frida_device_manager_get_type" glib:type-struct="DeviceManagerClass" parent="GObject.Object" final="1">
      <doc xml:space="preserve" filename="src/frida.vala" line="36">Enumerates and keeps track of the devices available to Frida, and is the
usual entry point of the API.

Create one, then obtain a [class@Frida.Device] — for example the local system
via [method@Frida.DeviceManager.get_device_by_type] with
`DeviceType.LOCAL`, or a USB-connected device.</doc>
      <constructor name="new" c:identifier="frida_device_manager_new">
        <doc xml:space="preserve" filename="src/frida.vala" line="79">Creates a new device manager with all backends enabled.</doc>
        <return-value transfer-ownership="full">
          <type name="Frida.DeviceManager" c:type="FridaDeviceManager*" />
        </return-value>
      </constructor>
      <constructor name="with_nonlocal_backends_only" c:identifier="frida_device_manager_new_with_nonlocal_backends_only">
        <doc xml:space="preserve" filename="src/frida.vala" line="86">Creates a device manager with only the non-local backends enabled, so
the local system is not exposed as a device.</doc>
        <return-value transfer-ownership="full">
          <type name="Frida.DeviceManager" c:type="FridaDeviceManager*" />
        </return-value>
      </constructor>
      <constructor name="with_socket_backend_only" c:identifier="frida_device_manager_new_with_socket_backend_only">
        <doc xml:space="preserve" filename="src/frida.vala" line="94">Creates a device manager with only the socket backend enabled, for
connecting to remote devices over the network.</doc>
        <return-value transfer-ownership="full">
          <type name="Frida.DeviceManager" c:type="FridaDeviceManager*" />
        </return-value>
      </constructor>
