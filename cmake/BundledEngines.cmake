if(EXISTS "${INDAGO_RUNTIME_PAYLOAD_DIR}/ilspy")
    if(WIN32)
        set(_ilspy_host indago_ilspy_worker.exe)
    else()
        set(_ilspy_host indago_ilspy_worker)
