set(_entries "")
if(NOT WIN32 AND EXISTS "${INDAGO_RUNTIME_PAYLOAD_DIR}/replay/bin/rr")
    foreach(_required bin/rr_exec_stub bin/rr_exec_stub_32 lib/rr/librrpreload.so lib/rr/librrpreload_32.so lib/rr/librrpage.so lib/rr/librrpage_32.so PROVENANCE.md LICENSE)
        if(NOT EXISTS "${INDAGO_RUNTIME_PAYLOAD_DIR}/replay/${_required}")
