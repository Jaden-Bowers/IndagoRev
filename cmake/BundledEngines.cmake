set(_source "")
set(INDAGO_BUNDLE_PROFILE "runtime" CACHE STRING "Bundled engine profile: runtime or full")
set_property(CACHE INDAGO_BUNDLE_PROFILE PROPERTY STRINGS runtime full)
if(NOT INDAGO_BUNDLE_PROFILE STREQUAL "runtime" AND NOT INDAGO_BUNDLE_PROFILE STREQUAL "full")
    message(FATAL_ERROR "INDAGO_BUNDLE_PROFILE must be runtime or full")
endif()
set(_omitted_bytes 0)
set(_included_bytes 0)
set(_expanded_bytes 0)
set(_compressed_count 0)
set(_omitted_count 0)
set(_identity "")
set(_embedded_inputs "")
set(_id 201)
foreach(_file _name IN ZIP_LISTS _files _names)
    file(SIZE "${_file}" _size)
    set(_omit false)
    if(INDAGO_BUNDLE_PROFILE STREQUAL "runtime")
        # jmods are for constructing new Java runtimes, not running javac or
        # DecompInterface. Retain lib/modules, javac, sources and all notices.
        if(_name MATCHES "^ghidra/java/jmods/")
            set(_omit true)
        endif()
        if(_name MATCHES "^ghidra/distribution/.*/os/([^/]+)/")
            set(_native_os "${CMAKE_MATCH_1}")
            if(WIN32 AND NOT _native_os STREQUAL "win_x86_64")
                set(_omit true)
            elseif(NOT WIN32 AND NOT _native_os STREQUAL "linux_x86_64")
                set(_omit true)
            endif()
        endif()
    endif()
    if(_omit)
        math(EXPR _omitted_bytes "${_omitted_bytes}+${_size}")
        math(EXPR _omitted_count "${_omitted_count}+1")
        continue()
    endif()
    file(SHA256 "${_file}" _sha)
    indago_select_payload("${_file}" "${_sha}" "${_size}" _stored_file _stored_size _compressed)
    math(EXPR _included_bytes "${_included_bytes}+${_stored_size}")
    math(EXPR _expanded_bytes "${_expanded_bytes}+${_size}")
    if(_compressed)
        math(EXPR _compressed_count "${_compressed_count}+1")
    endif()
    list(APPEND _embedded_inputs "${_stored_file}")
    string(APPEND _identity "${_name}:${_sha}\n")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
    if(WIN32)
        string(APPEND _source "${_id} RCDATA \"${_stored_file}\"\n")
        string(APPEND _entries "{${_id}, \"${_name}\", \"${_sha}\", nullptr, ${_size}, ${_stored_size}, ${_compressed}},\n")
    else()
        string(APPEND _source ".section .rodata\n.global payload_${_id}_begin\n.global payload_${_id}_end\npayload_${_id}_begin:\n.incbin \"${_stored_file}\"\npayload_${_id}_end:\n")
        string(APPEND _header "extern \"C\" const unsigned char payload_${_id}_begin[], payload_${_id}_end[];\n")
        string(APPEND _entries "{${_id}, \"${_name}\", \"${_sha}\", payload_${_id}_begin, ${_size}, static_cast<std::size_t>(payload_${_id}_end-payload_${_id}_begin), ${_compressed}},\n")
    endif()
    math(EXPR _id "${_id}+1")
endforeach()
indago_write_if_different("${CMAKE_CURRENT_BINARY_DIR}/generated/bundle-profile.json" "{\"profile\":\"${INDAGO_BUNDLE_PROFILE}\",\"included_bytes\":${_included_bytes},\"expanded_bytes\":${_expanded_bytes},\"compressed_files\":${_compressed_count},\"omitted_bytes\":${_omitted_bytes},\"omitted_files\":${_omitted_count},\"policy\":\"lossless staged compression; omit Java runtime-construction modules and foreign-OS native helpers; retain runtime, compiler, source archives and notices\"}\n")
string(SHA256 _bundle_sha "${_identity}")
string(APPEND _header "static const PayloadEntry engine_payload[] = {\n${_entries}{0,nullptr,nullptr,nullptr,0,0,false}};\nstatic constexpr auto engine_bundle_sha = \"${_bundle_sha}\";\n")
indago_write_if_different("${CMAKE_CURRENT_BINARY_DIR}/generated/engine_payload.hpp" "${_header}")
if(WIN32)
    indago_write_if_different("${CMAKE_CURRENT_BINARY_DIR}/generated/engines.rc" "${_source}")
    target_sources(indago PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated/engines.rc")
else()
    string(APPEND _source ".section .note.GNU-stack,\"\",@progbits\n")
    indago_write_if_different("${CMAKE_CURRENT_BINARY_DIR}/generated/engines.S" "${_source}")
    # .incbin is not a C/C++ include and compiler depfiles do not track it.
    # Content-stable assembly still needs rebuilding when a referenced payload
    # changes, even when its path and length are identical.
    set_property(SOURCE "${CMAKE_CURRENT_BINARY_DIR}/generated/engines.S"
        APPEND PROPERTY OBJECT_DEPENDS "${_embedded_inputs}")
    target_sources(indago_core PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated/engines.S")
endif()
