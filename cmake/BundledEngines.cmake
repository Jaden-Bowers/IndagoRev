option(INDAGO_ALLOW_UNSTAGED_GDB "Allow a Linux native-core build without the private GDB payload" OFF)
if(NOT WIN32 AND (EXISTS "${INDAGO_RUNTIME_PAYLOAD_DIR}/gdb/bin/gdb" OR NOT INDAGO_ALLOW_UNSTAGED_GDB))
    if(NOT EXISTS "${INDAGO_RUNTIME_PAYLOAD_DIR}/gdb/bin/gdb")
        message(FATAL_ERROR "Private GDB required on Linux; run tools/build-gdb.sh")
    endif()
    file(GLOB_RECURSE _gdb_files CONFIGURE_DEPENDS LIST_DIRECTORIES false "${INDAGO_RUNTIME_PAYLOAD_DIR}/gdb/*")
    foreach(_file IN LISTS _gdb_files)
        file(RELATIVE_PATH _name "${INDAGO_RUNTIME_PAYLOAD_DIR}" "${_file}")
        list(APPEND _files "${_file}")
        list(APPEND _names "${_name}")
    endforeach()
endif()
if(EXISTS "${INDAGO_RUNTIME_PAYLOAD_DIR}/ghidra")
    if(WIN32)
        set(_gh_native "distribution/Ghidra/Features/Decompiler/os/win_x86_64/decompile.exe")
        set(_gh_java "java/bin/java.exe")
    else()
        set(_gh_native "distribution/Ghidra/Features/Decompiler/os/linux_x86_64/decompile")
        set(_gh_java "java/bin/java")
    endif()
    foreach(_required "${_gh_native}" "${_gh_java}" "distribution/Ghidra/application.properties" "distribution/Ghidra/Framework/Utility/lib/Utility.jar" "java/release")
        if(NOT EXISTS "${INDAGO_RUNTIME_PAYLOAD_DIR}/ghidra/${_required}")
            message(FATAL_ERROR "Incomplete Ghidra payload: ${_required}; run tools/bundle-ghidra")
        endif()
    endforeach()
    file(GLOB_RECURSE _gh_files CONFIGURE_DEPENDS LIST_DIRECTORIES false "${INDAGO_RUNTIME_PAYLOAD_DIR}/ghidra/*")
    foreach(_file IN LISTS _gh_files)
        file(RELATIVE_PATH _name "${INDAGO_RUNTIME_PAYLOAD_DIR}" "${_file}")
        list(APPEND _files "${_file}")
        list(APPEND _names "${_name}")
    endforeach()
    file(GLOB _scripts CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/workers/ghidra/scripts/*.java")
    foreach(_file IN LISTS _scripts)
        get_filename_component(_name "${_file}" NAME)
        list(APPEND _files "${_file}")
        list(APPEND _names "ghidra/scripts/${_name}")
    endforeach()
    target_compile_definitions(indago_core PUBLIC INDAGO_HAS_GHIDRA=1)
else()
    target_compile_definitions(indago_core PUBLIC INDAGO_HAS_GHIDRA=0)
