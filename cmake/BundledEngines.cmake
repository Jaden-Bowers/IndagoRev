# Source-built runtime payloads are prepared by tools/build-runtime-engines.*.
# No downloads take place in the product or during its normal CMake build.
include("${CMAKE_CURRENT_LIST_DIR}/StableGeneratedFile.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PackedPayload.cmake")
option(INDAGO_ENABLE_PAYLOAD_COMPRESSION "Use explicitly staged lossless payload representations" ON)
set(INDAGO_PACKED_PAYLOAD_DIR "${CMAKE_CURRENT_SOURCE_DIR}/out/payload-packed" CACHE PATH "Content-addressed, verified packed payloads")
if(INDAGO_ENABLE_PAYLOAD_COMPRESSION)
    file(GLOB _packed_metadata CONFIGURE_DEPENDS "${INDAGO_PACKED_PAYLOAD_DIR}/*.json")
endif()
set(_files "")
set(_names "")
foreach(_notice LICENSE COPYING)
    list(APPEND _files "${CMAKE_CURRENT_SOURCE_DIR}/vendor/zstd/upstream/${_notice}")
    list(APPEND _names "licenses/zstd/${_notice}")
endforeach()
list(APPEND _files "${CMAKE_CURRENT_SOURCE_DIR}/vendor/zstd/PROVENANCE.md")
list(APPEND _names "licenses/zstd/PROVENANCE.md")
if(TARGET LIEF::LIEF)
    foreach(_notice LICENSE PROVENANCE.md THIRD-PARTY.md dependency-archives.json Boost-1.0.txt json-LICENSE.MIT fmt-LICENSE.txt)
        list(APPEND _files "${CMAKE_CURRENT_SOURCE_DIR}/vendor/lief/${_notice}")
        list(APPEND _names "licenses/lief/${_notice}")
    endforeach()
    file(GLOB_RECURSE _lief_notices CONFIGURE_DEPENDS LIST_DIRECTORIES false "${CMAKE_CURRENT_SOURCE_DIR}/vendor/lief/notices/*")
    foreach(_file IN LISTS _lief_notices)
        file(RELATIVE_PATH _notice "${CMAKE_CURRENT_SOURCE_DIR}/vendor/lief" "${_file}")
        list(APPEND _files "${_file}")
        list(APPEND _names "licenses/lief/${_notice}")
    endforeach()
endif()
if(WIN32)
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8 OR CMAKE_GENERATOR_PLATFORM MATCHES "ARM")
        message(FATAL_ERROR "The Windows host is x64; target processes may be x86 or x64")
    endif()
    enable_language(RC)
    target_link_options(indago PRIVATE /DELAYLOAD:dbghelp.dll)
    target_link_libraries(indago PRIVATE delayimp)
    set(_dbg "${CMAKE_CURRENT_SOURCE_DIR}/vendor/dbgeng")
    target_include_directories(indago_core PRIVATE "${_dbg}/build/native/inc")
    foreach(_name dbgeng.dll dbghelp.dll dbgcore.dll dbgmodel.dll msdia140.dll)
        list(APPEND _files "${_dbg}/content/amd64/${_name}")
        list(APPEND _names "dbgeng/${_name}")
    endforeach()
    list(APPEND _files "${_dbg}/LICENSE.rtf")
    list(APPEND _names "dbgeng/LICENSE.rtf")
    set(_os windows)
else()
    enable_language(ASM)
    set(_os linux)
    list(APPEND _files "${CMAKE_CURRENT_SOURCE_DIR}/vendor/openssl/NOTICE.txt" "${CMAKE_CURRENT_SOURCE_DIR}/vendor/openssl/Apache-2.0.txt")
    list(APPEND _names "licenses/openssl/NOTICE.txt" "licenses/openssl/Apache-2.0.txt")
    foreach(_notice jitterentropy zlib zstd)
        list(APPEND _files "${CMAKE_CURRENT_SOURCE_DIR}/vendor/openssl/${_notice}-NOTICE.txt")
        list(APPEND _names "licenses/openssl/${_notice}-NOTICE.txt")
    endforeach()
endif()
set(INDAGO_RUNTIME_PAYLOAD_DIR "${CMAKE_CURRENT_SOURCE_DIR}/out/runtime-payload/${_os}" CACHE PATH "Privately bundled source-built runtime engines")
if(EXISTS "${INDAGO_RUNTIME_PAYLOAD_DIR}/dynamorio")
    foreach(_bits 32 64)
        if(WIN32)
            set(_required "bin${_bits}/indago_dr_host.exe" "bin${_bits}/drinjectlib.dll" "bin${_bits}/drconfiglib.dll" "lib${_bits}/indago_dr_client.dll" "lib${_bits}/release/dynamorio.dll")
        else()
            set(_required "bin${_bits}/indago_dr_host" "lib${_bits}/libindago_dr_client.so" "lib${_bits}/release/libdynamorio.so")
        endif()
        foreach(_file IN LISTS _required)
            if(NOT EXISTS "${INDAGO_RUNTIME_PAYLOAD_DIR}/dynamorio/${_file}")
                message(FATAL_ERROR "Incomplete runtime payload: ${_file}; rerun tools/build-runtime-engines")
            endif()
        endforeach()
    endforeach()
    file(GLOB_RECURSE _dr_files CONFIGURE_DEPENDS LIST_DIRECTORIES false "${INDAGO_RUNTIME_PAYLOAD_DIR}/dynamorio/*")
    foreach(_file IN LISTS _dr_files)
        file(RELATIVE_PATH _name "${INDAGO_RUNTIME_PAYLOAD_DIR}" "${_file}")
        list(APPEND _files "${_file}")
        list(APPEND _names "${_name}")
    endforeach()
    target_compile_definitions(indago_core PUBLIC INDAGO_HAS_DYNAMORIO=1)
else()
    target_compile_definitions(indago_core PUBLIC INDAGO_HAS_DYNAMORIO=0)
endif()
set(_header "#pragma once\n#include <cstddef>\nstruct PayloadEntry { unsigned id; const char* name; const char* sha; const unsigned char* data; std::size_t size; std::size_t stored_size; bool compressed; };\n")
if(EXISTS "${INDAGO_RUNTIME_PAYLOAD_DIR}/frida")
