    foreach(_required "${_ilspy_host}" "indago_ilspy_worker.dll" "indago_ilspy_worker.runtimeconfig.json" "ICSharpCode.Decompiler.dll" "ILSpy-LICENSE.txt" "dotnet-LICENSE.TXT" "dotnet-THIRD-PARTY-NOTICES.TXT" "packages.lock.json")
        if(NOT EXISTS "${INDAGO_RUNTIME_PAYLOAD_DIR}/ilspy/${_required}")
