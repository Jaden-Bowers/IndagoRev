{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indagorev.local/contracts/indago.result.v1.schema.json",
  "title": "IndagoRev result",
  "type": "object",
  "required": ["schema", "request_id", "status", "result_revision", "completeness", "backend", "artifact_sha256", "evidence_ids", "raw_sha256", "diagnostics"],
  "properties": {
    "schema": {"const": "indago.result.v1"},
    "request_id": {"type": "string", "pattern": "^job_"},
    "status": {"enum": ["completed", "partial", "failed", "cancelled", "timeout", "unavailable", "invalid_request", "not_found", "interrupted"]},
    "result_revision": {"type": "string", "pattern": "^rev_"},
    "completeness": {"enum": ["complete", "partial", "unknown"]},
    "backend": {"enum": ["airece", "xair", "sym", "ghidra", "ilspy", "capa", "floss", "lief", "wireshark", "runtime"]},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ev_"}},
    "data": {"type": "object"},
    "data_omitted": {"type": "boolean"},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
