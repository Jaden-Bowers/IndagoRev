{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://indagorev.local/contracts/indago.workbench.v1.schema.json",
  "title":"Deterministic knowledge workbench request envelope",
  "description":"Shared transport types. Native operation validators additionally enforce required fields, allowed field sets, ownership, cross-project references, operation-specific bounds and scientific-state restrictions.",
  "type":"object","required":["family","operation","request"],"additionalProperties":false,
  "properties":{
    "family":{"enum":["workbench","knowledge","system","graph","coverage","recognize","transform","validate","batch","bundle","retention"]},
    "operation":{"type":"string","minLength":1,"maxLength":32},
    "request":{
      "type":"object","additionalProperties":false,
      "properties":{
        "project":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,128}$"},
        "manifest":{"type":"object"},
        "id":{"type":"string","minLength":1,"maxLength":128},
        "expected_revision":{"type":"integer","minimum":0,"maximum":100000000},
        "revision":{"type":"integer","minimum":0,"maximum":100000000},
        "kind":{"type":"string","minLength":1,"maxLength":64},
        "title":{"type":"string","minLength":1,"maxLength":4096},
        "state":{"enum":["observed","derived","inferred","contradicted","unknown","validated"]},
        "scope":{"type":"object"},"body":{"type":"object"},"author":{"type":"string","maxLength":256},
        "assumptions":{"type":"array","maxItems":128},
        "support":{"type":"array","maxItems":128,"items":{"type":"string","maxLength":128}},
        "counterevidence":{"type":"array","maxItems":128,"items":{"type":"string","maxLength":128}},
        "dependencies":{"type":"array","maxItems":128,"items":{"type":"object","required":["type","id"],"additionalProperties":false,"properties":{"type":{"enum":["record","artifact","entity","evidence","revision","observation","epoch"]},"id":{"type":"string","minLength":1,"maxLength":128},"pin":{"type":"string","minLength":1,"maxLength":128}}}},
        "type":{"type":"string","maxLength":32},
        "search":{"type":"string","maxLength":4096},"history":{"type":"boolean"},
        "artifact":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "anchor":{"type":"string","minLength":1,"maxLength":128},
        "address":{"type":"string","pattern":"^0x[0-9a-fA-F]{1,16}$"},
        "observation":{"type":"string","minLength":1,"maxLength":128},
        "direction":{"enum":["in","out","both"]},
        "kinds":{"type":"array","maxItems":32,"items":{"type":"string","maxLength":64}},
        "depth":{"type":"integer","minimum":0,"maximum":8},
        "offset":{"type":"integer","minimum":0,"maximum":67108864},
        "size":{"type":"integer","minimum":0,"maximum":4194304},
        "limit":{"type":"integer","minimum":1,"maximum":10000},
        "scan_limit":{"type":"integer","minimum":1,"maximum":100000},
        "output_bytes":{"type":"integer","minimum":4096,"maximum":2097152},
        "max_bytes":{"type":"integer","minimum":1,"maximum":8589934592},
        "publish":{"type":"boolean"},
        "spec":{"type":"object","required":["method"],"additionalProperties":false,"properties":{"method":{"enum":["slice","xor","hex_decode","base64_decode"]},"key_hex":{"type":"string","pattern":"^[a-fA-F0-9]+$","maxLength":8192}}},
        "subject":{"type":"string","minLength":1,"maxLength":128},
        "cases":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"object"}},
        "steps":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"object"}},
        "budget":{"type":"object"},"retry_failed":{"type":"boolean"},"reset_cancel":{"type":"boolean"},
        "source":{"type":"string","minLength":1,"maxLength":32768},"destination":{"type":"string","minLength":1,"maxLength":32768},
        "plan_digest":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    }
  }
}
