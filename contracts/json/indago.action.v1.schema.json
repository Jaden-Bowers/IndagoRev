{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indagorev.local/contracts/indago.action.v1.schema.json",
  "title": "IndagoRev action",
  "type": "object",
  "required": ["project", "backend", "operation"],
  "properties": {
    "schema": {"const": "indago.action.v1"},
    "project": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "backend": {"enum": ["airece", "xair", "sym", "ghidra", "ilspy", "capa", "floss", "lief", "wireshark"]},
    "operation": {"type": "string", "minLength": 1, "maxLength": 64},
    "target_id": {"type": "string", "pattern": "^tgt_[a-f0-9]+$"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "address": {"type": "string", "maxLength": 256},
    "view": {"enum": ["compact", "agent", "pseudocode", "disassembly", "json"]},
    "arguments": {"type": "object"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "budget": {
      "type": "object",
      "properties": {
        "wall_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
        "memory_bytes": {"type": "integer", "minimum": 1048576, "maximum": 2147483648},
        "output_bytes": {"type": "integer", "minimum": 4096, "maximum": 67108864},
        "max_items": {"type": "integer", "minimum": 1, "maximum": 100000}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
