{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Indago explicit runtime action",
  "type": "object",
  "required": ["operation"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "indago.runtime-action.v1"},
    "operation": {"enum": ["capabilities", "payloads", "launch", "attach", "instrument", "record", "replay", "sessions", "status", "request", "modules", "threads", "continue", "pause", "step", "step-over", "step-out", "stack", "crash", "watchpoint", "breakpoints", "processes", "select-process", "validate-witness", "breakpoint", "remove-breakpoint", "registers", "memory", "capture", "resolve", "trace", "cancel", "observations", "network", "symbolic", "detach", "terminate", "reanalyze", "feedback", "lineage", "recipes", "identities"]},
    "terminal_index": {"type": "integer", "minimum": 0, "maximum": 31},
    "branch_index": {"type": "integer", "minimum": 0, "maximum": 1},
    "follow_children": {"type": "boolean"},
    "telemetry": {"enum": ["blocks", "effects"]},
    "code_scope": {"enum": ["main", "all", "application"]},
    "one_shot": {"type": "boolean"},
    "hardware": {"type": "boolean"},
    "expression": {"type": "string", "minLength": 1, "maxLength": 1024},
    "condition": {"type": "string", "maxLength": 1024},
    "breakpoint_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "access": {"enum": ["read", "write", "readwrite"]},
    "backend": {"enum": ["dynamorio", "frida", "rr", "xair", "ghidra", "both"]},
    "recipe": {"enum": ["io", "code", "modules", "config", "network"]},
    "project": {"type": "string", "minLength": 1, "maxLength": 128},
    "session": {"type": "string", "maxLength": 128},
    "id": {"type": "string", "maxLength": 128},
    "file": {"type": "string", "maxLength": 32768},
    "cwd": {"type": "string", "maxLength": 32768},
    "argv": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 16384}},
    "pid": {"type": ["integer", "string"]},
    "thread": {"type": ["integer", "string"]},
    "address": {"type": ["integer", "string"]},
    "static_address": {"type": ["integer", "string"]},
    "rva": {"type": ["integer", "string"]},
    "size": {"type": ["integer", "string"]},
    "from": {"type": ["integer", "string"]},
    "to": {"type": ["integer", "string"]},
    "function": {"type": "string", "maxLength": 128},
    "artifact": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "module": {"type": "string", "maxLength": 128},
    "anchor": {"type": "string", "maxLength": 128},
    "kind": {"type": "string", "maxLength": 128},
    "limit": {"type": ["integer", "string"]},
    "offset": {"type": ["integer", "string"]},
    "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
    "trace_bytes": {"type": "integer", "minimum": 1048576, "maximum": 134217728},
    "lifetime_ms": {"type": "integer", "minimum": 1000, "maximum": 86400000},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 10000},
    "max_events": {"type": "integer", "minimum": 1, "maximum": 10000},
    "wait": {"type": "boolean"},
    "signal": {"type": "integer", "minimum": -1, "maximum": 64},
    "memory": {"type": "array", "maxItems": 16, "items": {"type": "object", "required": ["address", "size"], "additionalProperties": false, "properties": {"address": {"type": ["integer", "string"]}, "size": {"type": "integer", "minimum": 1, "maximum": 65536}}}},
    "code_regions": {"type": "array", "maxItems": 16, "items": {"type": "object", "required": ["address", "size"], "additionalProperties": false, "properties": {"address": {"type": ["integer", "string"]}, "size": {"type": "integer", "minimum": 1, "maximum": 65536}}}},
    "observation": {"type": "string", "maxLength": 128},
    "mode": {"enum": ["solve_branch", "path_condition", "symbolic_slice", "taint", "source_to_sink"]},
    "sink": {"type": "string", "maxLength": 16},
    "path": {"type": "array", "maxItems": 16, "items": {"type": ["integer", "string"]}},
    "symbolic_registers": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 8}},
    "symbolic_memory": {"type": "array", "maxItems": 16, "items": {"type": "object", "required": ["address", "size"], "additionalProperties": false, "properties": {"address": {"type": ["integer", "string"]}, "size": {"type": "integer", "minimum": 1, "maximum": 256}}}}
  }
}
